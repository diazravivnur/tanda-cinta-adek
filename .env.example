# Firebase Web Client Configuration
# Dapatkan nilai ini dari Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here

# Untuk iOS PWA standalone, gunakan domain hosting sendiri (misal: your_project.web.app)
# agar redirect OAuth tetap berada di dalam jendela standalone PWA
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.web.app

VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# Gunakan Firebase Emulator saat pengembangan lokal dan pengujian (true/false)
VITE_USE_FIREBASE_EMULATOR=false
